+
+  // DEMO-TMP: opens a dialog or a pane for a screenshot (not to be committed)
+  if (wxString demo; wxGetEnv("KENNEL_DEMO", &demo)) {
+    auto *timer = new wxTimer();
+    timer->Bind(wxEVT_TIMER, [this, demo](wxTimerEvent &) {
+      if (demo == "switch") {
+        m_mainView->GetSessionsBook()->SwitchPage(true);
+      } else if (demo == "goto") {
+        wxCommandEvent e;
+        OnGotoAnything(e);
+      } else if (demo == "explorer") {
+        m_mainView->DemoSideSelect(1);
+      } else if (demo == "start") {
+        wxCommandEvent e;
+        OnStartAgent(e);
+      } else if (demo == "wizard") {
+        wxCommandEvent e;
+        OnNewAgent(e);
+      } else if (demo == "review") {
+        if (auto *page = m_mainView->GetSessionsBook()->GetActiveSessionPage()) {
+          page->StartReviewBuddy("kiro-cli");
+        }
+      }
+    });
+    timer->StartOnce(4000);
+  }
 }
 
